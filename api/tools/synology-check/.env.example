# The NAS the check and the probes talk to, and the account they sign in as.
# Copy to .env beside this file (it is gitignored) and keep it mode 0600: the
# password is in clear. A one-time code, when DSM wants one, is asked for on
# the terminal, so CHECK_OTP is only for a run with no terminal.
DSM_URL=http://192.0.2.10:5000
CHECK_USER=<your-dsm-account>
CHECK_PASS=<its-password>

# The Team Folder and folder the Drive section reads, exactly as Drive spells
# them (case matters), and the writes you allow. See README.md for the rest.
PLANNER_ROOT=/<team-folder>/<folder>
#CHECK_DRIVE_WRITE=1
#CHECK_CALENDAR_WRITE=1
#CHECK_SHARE_WITH=<another-dsm-account>
#CHECK_CONTACTS_WRITE=1
#CHECK_SECOND_TEAM=<another-team-folder>
#CHECK_ADMIN_USER=<an-administrator>
#CHECK_ADMIN_PASS=<its-password>

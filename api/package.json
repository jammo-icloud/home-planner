{
  "name": "household-budget-api",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "fake-dsm": "node --env-file=../.env --experimental-strip-types tools/fake-dsm/server.ts",
    "synology:check": "node --env-file-if-exists=tools/synology-check/.env --experimental-strip-types tools/synology-check/check.ts",
    "synology:probe": "node --env-file-if-exists=tools/synology-check/.env --experimental-strip-types tools/synology-check/probes/run.ts",
    "start": "node --experimental-strip-types src/server.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0"
  }
}
